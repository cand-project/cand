{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cand-project.dev/schema/cand-check-v1.json",
  "title": "C& check result v1",
  "type": "object",
  "required": [
    "schema",
    "cand_version",
    "result",
    "safety_level",
    "profile",
    "findings",
    "unsupported",
    "coverage",
    "borrow_analysis"
  ],
  "properties": {
    "schema": { "const": "cand.check/v1" },
    "cand_version": { "type": "string" },
    "result": { "enum": ["pass", "fail", "incomplete"] },
    "safety_level": {
      "enum": [
        "p0-temporal-lifecycle",
        "p1-unique-ownership",
        "p2-borrow-lifetime",
        "cand1"
      ]
    },
    "profile": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rule_id",
          "severity",
          "safety_level",
          "message_key",
          "message",
          "repair_class",
          "object_id",
          "primary_location",
          "state_trace"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^CAND-[A-Z][0-9]{3}$" },
          "rule_id": { "type": "string" },
          "severity": { "enum": ["error", "warning", "note"] },
          "certainty": { "enum": ["definite", "possible"] },
          "state_before_access": { "type": "string" },
          "safety_level": {
            "enum": [
              "p0-temporal-lifecycle",
              "p1-unique-ownership",
              "p2-borrow-lifetime",
              "cand1"
            ]
          },
          "message_key": { "type": "string" },
          "message": { "type": "string" },
          "repair_class": {
            "enum": [
              "ANNOTATION_ONLY",
              "SEMANTICS_PRESERVING_REFACTOR",
              "SEMANTIC_REPAIR",
              "CONTRACT_REQUIRED",
              "UNSAFE_OR_UNSUPPORTED",
              "POLICY_CHANGE_REQUIRED"
            ]
          },
          "object_id": { "type": "string" },
          "access_storage": { "type": "string" },
          "destroy_storage": { "type": "string" },
          "owner_storage": { "type": "string" },
          "transition": { "type": "string" },
          "borrow": { "$ref": "#/$defs/borrow" },
          "parent": { "$ref": "#/$defs/borrowParent" },
          "invalid_access": { "$ref": "#/$defs/location" },
          "move_location": { "$ref": "#/$defs/location" },
          "primary_location": { "$ref": "#/$defs/location" },
          "state_trace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["event", "state", "location"],
              "properties": {
                "event": { "type": "string" },
                "state": { "type": "string" },
                "location": { "$ref": "#/$defs/location" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unsupported": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "primary_location"],
        "properties": {
          "id": { "const": "CAND-U001" },
          "kind": { "type": "string" },
          "symbol": { "type": "string" },
          "mechanism": { "type": "string" },
          "source_storage": { "type": "string" },
          "destination_storage": { "type": "string" },
          "tracked_state": { "type": "string" },
          "transport": { "type": "boolean" },
          "primary_location": { "$ref": "#/$defs/location" }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["functions_analyzed"],
      "properties": {
        "functions_analyzed": { "type": "integer", "minimum": 0 },
        "tracked_heap_objects": { "type": "integer", "minimum": 0 },
        "unsupported_ownership_operations": { "type": "integer", "minimum": 0 },
        "ownership_transitions": { "type": "integer", "minimum": 0 },
        "unsupported_ownership_transfers": { "type": "integer", "minimum": 0 },
        "heap_generation_widenings": { "type": "integer", "minimum": 0 },
        "unsupported_transport_operations": { "type": "integer", "minimum": 0 },
        "ownership_rule_set": { "const": "p1-unique-ownership-v1" },
        "transport_rule_set": { "const": "cand1-pointer-transport-v1" }
      },
      "additionalProperties": false
    },
    "borrow_analysis": {
      "type": "object",
      "required": [
        "borrows_created",
        "shared_borrows",
        "mutable_borrows",
        "invalidated_borrows",
        "unsupported_borrow_operations"
      ],
      "properties": {
        "borrows_created": { "type": "integer", "minimum": 0 },
        "shared_borrows": { "type": "integer", "minimum": 0 },
        "mutable_borrows": { "type": "integer", "minimum": 0 },
        "invalidated_borrows": { "type": "integer", "minimum": 0 },
        "unsupported_borrow_operations": { "type": "integer", "minimum": 0 },
        "rule_set": { "const": "p2-borrow-lifetime-v1" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"safety_level": {"enum": ["p2-borrow-lifetime", "cand1"]}}},
      "then": {"required": ["borrow_analysis"]}
    }
  ],
  "$defs": {
    "borrow": {
      "type": "object",
      "required": [
        "storage",
        "kind",
        "origin",
        "lifetime_source",
        "state",
        "created_at"
      ],
      "properties": {
        "storage": { "type": "string" },
        "storage_id": { "type": "string" },
        "kind": { "enum": ["shared", "mutable"] },
        "origin": { "type": "string" },
        "lifetime_source": { "type": "string" },
        "state": {
          "enum": ["Live", "Invalid", "MaybeInvalid", "Unknown"]
        },
        "created_at": { "$ref": "#/$defs/location" }
      },
      "additionalProperties": false
    },
    "borrowParent": {
      "type": "object",
      "required": ["object_id"],
      "properties": {
        "object_id": { "type": "string" },
        "invalidated_at": { "$ref": "#/$defs/location" }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "required": ["file", "line", "column"],
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 0 },
        "column": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
