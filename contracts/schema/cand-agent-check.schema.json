{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cand-project.github.io/cand/schema/cand-agent-check-v1.json",
  "title": "C& agent check v1",
  "type": "object",
  "required": ["schema", "result", "semantic_result", "policy_result", "profile", "safety_level", "policy_delta", "analysis", "effective_policy", "evidence"],
  "properties": {
    "schema": {"const": "cand.agent-check/v1"},
    "result": {"enum": ["pass", "fail", "incomplete", "fail-policy", "review-required", "policy-error"]},
    "semantic_result": {"type": "string"},
    "policy_result": {"enum": ["pass", "fail", "review_required"]},
    "profile": {"type": "string"}, "safety_level": {"type": "string"},
    "policy_delta": {"type": "object"}, "analysis": {"type": "object"},
    "effective_policy": {"type": "object"}, "evidence": {"$ref": "cand-evidence-v1.json"},
    "evidence_path": {"type": "string"}
  }
}
