{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cand-project.github.io/cand/schema/cand-evidence-v1.json",
  "title": "C& verification evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result", "semantic_result", "policy_result", "cand", "source", "frontend", "verification", "analysis", "contracts", "proof_policy_delta", "integrity_sha256"],
  "properties": {
    "schema": {"const": "cand.evidence/v1"},
    "result": {"enum": ["pass", "fail", "incomplete", "fail-policy", "review-required"]},
    "semantic_result": {"enum": ["pass", "fail", "incomplete", "internal-error"]},
    "policy_result": {"enum": ["pass", "fail", "review_required"]},
    "cand": {"type": "object", "additionalProperties": false, "required": ["version", "build_identity", "verifier_source_commit", "binary_sha256"], "properties": {"version": {"type": "string"}, "build_identity": {"type": "string"}, "verifier_source_commit": {"pattern": "^[0-9a-f]{40}$"}, "binary_sha256": {"pattern": "^[0-9a-f]{64}$"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "files"], "properties": {"commit": {"pattern": "^[0-9a-f]{40}$"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/digest_file"}}}},
    "frontend": {"type": "object", "additionalProperties": false, "required": ["compiler", "version", "llvm_version", "arguments"], "properties": {"compiler": {"const": "clang"}, "version": {"type": "string"}, "llvm_version": {"type": "string"}, "arguments": {"type": "array", "items": {"type": "string"}}}},
    "verification": {"type": "object", "additionalProperties": false, "required": ["profile", "safety_level", "policy_path", "base_ref", "policy_revision", "trusted_base_sha", "effective_policy_sha256", "checked_scope"], "properties": {"profile": {"const": "generated"}, "safety_level": {"const": "p0-temporal-lifecycle"}, "policy_path": {"type": "string"}, "base_ref": {"const": "origin/main"}, "policy_revision": {"pattern": "^[0-9a-f]{40}$"}, "trusted_base_sha": {"pattern": "^[0-9a-f]{40}$"}, "effective_policy_sha256": {"pattern": "^[0-9a-f]{64}$"}, "checked_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "analysis": {"type": "object", "additionalProperties": false, "required": ["functions_analyzed", "tracked_heap_objects", "unsupported_ownership_operations", "unsafe_boundaries", "suppressions"], "properties": {"functions_analyzed": {"type": "integer", "minimum": 0}, "tracked_heap_objects": {"type": "integer", "minimum": 0}, "unsupported_ownership_operations": {"type": "integer", "minimum": 0}, "unsafe_boundaries": {"type": "integer", "minimum": 0}, "suppressions": {"type": "integer", "minimum": 0}}},
    "contracts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "trust_class"], "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}, "trust_class": {"enum": ["builtin", "verified", "reviewed"]}}}},
    "proof_policy_delta": {"type": "object", "additionalProperties": false, "required": ["weakened", "review_required", "changes"], "properties": {"weakened": {"type": "boolean"}, "review_required": {"type": "boolean"}, "changes": {"type": "array"}}},
    "integrity_sha256": {"pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {"digest_file": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\0]+$"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}}}
}
