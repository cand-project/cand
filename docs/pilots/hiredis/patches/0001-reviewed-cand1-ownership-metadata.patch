Exact disposable patch for Hiredis 33a12fb23531f33e3455c7ed46008c20c7ad9c78.
The metadata compiles away for ordinary builds and is not global C& policy.

diff --git a/cand-pilot.h b/cand-pilot.h
new file mode 100644
--- /dev/null
+++ b/cand-pilot.h
@@ -0,0 +1,13 @@
+#ifndef HIREDIS_CAND_PILOT_H
+#define HIREDIS_CAND_PILOT_H
+
+#if defined(CAND_ANALYSIS) && defined(__clang__)
+#define CAND_PILOT_ANNOTATE(value) __attribute__((annotate(value)))
+#else
+#define CAND_PILOT_ANNOTATE(value)
+#endif
+
+#define CAND_RETURNS_OWN CAND_PILOT_ANNOTATE("cand:returns_own")
+#define CAND_DESTROYS CAND_PILOT_ANNOTATE("cand:destroys")
+
+#endif
